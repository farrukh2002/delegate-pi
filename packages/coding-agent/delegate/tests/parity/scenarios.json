{
	"steering": {
		"scope": [],
		"steer": "Use the other test runner.",
		"noProgressMs": 5000,
		"steps": [{ "expectSteer": "Use the other test runner." }, { "exit": 0 }]
	},
	"turn-final-answer": {
		"scope": [],
		"maxTurns": 1,
		"expect": { "status": "completed", "turns": 1, "summaryPrefix": "Finished at the limit" },
		"steps": [
			{ "emit": { "type": "turn_start" } },
			{ "assistant": { "id": "m1", "content": [{ "type": "text", "text": "Finished at the limit" }], "usage": { "input": 10 } } },
			{ "sleep": 300 },
			{ "emit": { "type": "turn_end" } },
			{ "exit": 0 }
		]
	},
	"turn-tool-work": {
		"scope": ["src"],
		"files": { "src/result.txt": "unchanged" },
		"maxTurns": 1,
		"expect": {
			"status": "blocked", "turns": 1, "scopeHeld": true, "summaryPrefix": "Turn budget reached: the child ran 1 turns",
			"files": { "src/result.txt": "last allowed turn finished", "src/extra.txt": null },
			"traceText": "tool finished before the stop"
		},
		"steps": [
			{ "emit": { "type": "turn_start" } },
			{
				"assistant": {
					"id": "m1", "usage": { "input": 10 },
					"content": [{ "type": "toolCall", "id": "t1", "name": "write", "arguments": { "path": "src/result.txt" } }]
				}
			},
			{ "sleep": 300 },
			{ "write": "src/result.txt", "text": "last allowed turn finished" },
			{
				"emit": {
					"type": "message_end",
					"message": { "role": "toolResult", "toolCallId": "t1", "toolName": "write", "content": [{ "type": "text", "text": "tool finished before the stop" }] }
				}
			},
			{ "emit": { "type": "turn_end" } },
			{ "emit": { "type": "turn_start" } },
			{ "sleep": 500 },
			{ "write": "src/extra.txt", "text": "must not run" },
			{ "exit": 0 }
		]
	},
	"turn-pi-native-limit": {
		"scope": [],
		"maxTurns": 1,
		"expect": { "status": "blocked", "turns": 1, "summaryPrefix": "Turn budget reached" },
		"steps": [
			{ "emit": { "type": "delegate_turn_limit", "turns": 1 } },
			{ "assistant": { "usage": {}, "stopReason": "aborted", "errorMessage": "Delegate turn limit reached." } },
			{ "exit": 0 }
		]
	},
	"turn-claude-native-limit": {
		"provider": "claude",
		"fake": "claude",
		"scope": [],
		"maxTurns": 1,
		"expect": { "status": "blocked", "turns": 1, "summaryPrefix": "Turn budget reached", "costUsd": 0.004 },
		"steps": [
			{ "emit": { "type": "result", "subtype": "error_max_turns", "is_error": true, "total_cost_usd": 0.004 } },
			{ "exit": 1 }
		]
	},
	"turn-commandcode-next": {
		"provider": "commandcode",
		"fake": "commandcode",
		"scope": [],
		"maxTurns": 1,
		"expect": { "status": "blocked", "turns": 1, "summaryPrefix": "Turn budget reached" },
		"steps": [
			{ "emit": { "type": "event", "event": { "type": "turn_start" } } },
			{ "emit": { "type": "event", "event": { "type": "model_request_end", "usage": { "inputTokens": 50 } } } },
			{ "emit": { "type": "event", "event": { "type": "turn_start" } } },
			{ "exit": 0 }
		]
	},
	"turn-codex-over-limit": {
		"provider": "codex",
		"fake": "codex",
		"scope": [],
		"runtimeMode": "full-access",
		"maxTurns": 1,
		"expect": { "status": "blocked", "turns": 2, "summaryPrefix": "Turn budget reached" },
		"steps": [
			{ "emit": { "type": "turn.completed", "usage": { "input_tokens": 10 } } },
			{ "emit": { "type": "turn.completed", "usage": { "input_tokens": 11 } } },
			{ "exit": 0 }
		]
	},
	"turn-codex-next": {
		"provider": "codex",
		"fake": "codex",
		"scope": [],
		"runtimeMode": "full-access",
		"maxTurns": 1,
		"expect": { "status": "blocked", "turns": 1, "summaryPrefix": "Turn budget reached" },
		"steps": [
			{ "emit": { "type": "turn.started" } },
			{ "emit": { "type": "turn.completed", "usage": { "input_tokens": 10 } } },
			{ "emit": { "type": "turn.started" } },
			{ "exit": 0 }
		]
	},
	"context-budget": {
		"scope": [],
		"contextBudget": 10000,
		"expect": {
			"status": "blocked", "turns": 4, "summaryPrefix": "Context budget reached: the child carried 10001 tokens",
			"budgetNotice": "Context budget warning: this child carried 8000 of 10000 tokens in one request."
		},
		"steps": [
			{ "assistant": { "id": "m1", "usage": { "totalTokens": 7999 } } },
			{ "assistant": { "id": "m2", "usage": { "totalTokens": 8000 } } },
			{ "sleep": 250 },
			{ "assistant": { "id": "m3", "usage": { "totalTokens": 10000 } } },
			{ "sleep": 200 },
			{ "assistant": { "id": "m4", "usage": { "totalTokens": 10001 } } },
			{ "stderr": "Fixture shutdown diagnostic" },
			{ "exit": 0 }
		]
	},
	"loop-duplicate-calls": {
		"scope": [],
		"expect": { "status": "completed" },
		"steps": [{ "calls": ["t1", "t1", "t1", "t1", "t1", "t1"] }, { "exit": 0 }]
	},
	"loop-steer-and-stop": {
		"scope": [],
		"noProgressMs": 5000,
		"expect": { "status": "blocked", "steers": 1, "summaryPrefix": "Loop detected: the child repeated bash: check-fixture 5 times" },
		"steps": [
			{ "calls": ["t1", "t2", "t3"] },
			{ "expectGuard": true },
			{ "calls": ["t4", "t5"] },
			{ "sleep": 600 },
			{ "exit": 0 }
		]
	},
	"loop-rearms-after-edit": {
		"scope": ["src"],
		"files": { "src/result.txt": "before" },
		"noProgressMs": 5000,
		"expect": { "status": "completed", "steers": 2, "files": { "src/result.txt": "progress made" } },
		"steps": [
			{ "calls": ["t1", "t2", "t3"] },
			{ "expectGuard": true },
			{ "write": "src/result.txt", "text": "progress made" },
			{ "sleep": 250 },
			{ "calls": ["t4", "t5", "t6"] },
			{ "expectGuard": true },
			{ "exit": 0 }
		]
	},
	"loop-file-event-race": {
		"scope": ["src"],
		"files": { "src/result.txt": "before" },
		"expect": { "status": "completed", "files": { "src/result.txt": "progress made" } },
		"steps": [
			{ "calls": ["t1", "t2", "t3", "t4"] },
			{ "write": "src/result.txt", "text": "progress made" },
			{ "calls": ["t5"] },
			{ "sleep": 300 },
			{ "exit": 0 }
		]
	},
